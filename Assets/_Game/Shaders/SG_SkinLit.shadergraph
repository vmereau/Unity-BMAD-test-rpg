        {
            "m_Id": "5a36894ea4c24cf9bdebeb4270a56491"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SkinTone",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 albedo = SAMPLE_TEXTURE2D(BaseMap.tex, BaseMap.samplerstate, UV) * BaseColor;\nfloat mask = saturate(SAMPLE_TEXTURE2D(SkinMask.tex, SkinMask.samplerstate, UV).r * Strength);\nfloat lum = dot(albedo.rgb, float3(0.299, 0.587, 0.114));\nfloat3 toned = min(Tone.rgb * (lum / max(RefLum, 1e-4)), 1.0);\nAlbedo = lerp(albedo.rgb, toned, mask);\nNormalTS = UnpackNormalScale(SAMPLE_TEXTURE2D(BumpMap.tex, BumpMap.samplerstate, UV), BumpScale);"
}
