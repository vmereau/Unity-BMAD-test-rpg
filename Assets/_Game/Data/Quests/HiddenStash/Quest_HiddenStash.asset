  m_Script: {fileID: 11500000, guid: a0b39fb047c6fa040bb2f031da1e5ed1, type: 3}
  m_Name: Quest_HiddenStash
  m_EditorClassIdentifier: Game::Game.Quest.QuestSO
  questId: HiddenStash
  title: Food for Tam
  description: 'Tam took a beating from the Warden and he''s hungry. He doesn''t care where the food comes from: bread or an apple would do, and something cooked would surprise him. Brann''s chest in the gang house is there for the taking, if I''m willing to steal.'
  startPart:
    fact: {fileID: 11400000, guid: a0698f51b32c5f44fb6c0f3dd4a99c7e, type: 2}
    entry: Tam is hungry. Bread or an apple would do.
  completedParts:
  - fact: {fileID: 11400000, guid: fd03526f28e9bdc42adce7684f3636ac, type: 2}
    entry: I gave Tam something to eat.
  - fact: {fileID: 11400000, guid: af6aba729f8d36a4ba040005ebcff2cb, type: 2}
    entry: I gave Tam a cooked meal. He looked like he'd remember it.
  failedParts: []
  steps:
  - title: 'Optional: Brann''s supplies'
    description: Brann keeps food in a chest in the gang house by the lake. He leaves for the gang fire at six.
    parts:
    - fact: {fileID: 11400000, guid: 5f34ce168f54de643ba99ea684ac6c2a, type: 2}
      entry: Tam told me about Brann's chest.
    - fact: {fileID: 11400000, guid: 82b9f9368a27e2e43ab2ed0359aa323e, type: 2}
      entry: I helped myself to Brann's supplies.
