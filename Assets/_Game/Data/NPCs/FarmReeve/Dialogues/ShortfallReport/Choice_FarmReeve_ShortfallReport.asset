    giveToNpc: 0
    requiredCategory: 0
    hideWhenMissing: 1
    signal: {fileID: 0}
  - text: It's Venn. I caught him at the barn door.
    requiredMemory: {fileID: 11400000, guid: 96e9d2f6fea414242837330a3913c77c, type: 2}
    nextNode: {fileID: 11400000, guid: 892ad79aec3ff7f488849f7ac64e0c4b, type: 2}
