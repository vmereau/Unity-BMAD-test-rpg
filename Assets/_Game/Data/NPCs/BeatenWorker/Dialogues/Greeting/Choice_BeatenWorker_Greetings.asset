  m_Script: {fileID: 11500000, guid: a2bbd71de1c0dc944832b9f2ea09e57c, type: 3}
  m_Name: Choice_BeatenWorker_Greetings
  m_EditorClassIdentifier: Game::Game.Dialogue.ChoiceDialogueNode
  text: 'Tam. And yes, that was the Warden. It''s not the first time and I doubt it''ll be the last, so don''t fret over me. I''ll be fine, I just need to sit a while and let the ground stop moving.'
  nextNode: {fileID: 0}
  _id: 1ece443ac43f36640ae2247fdf072e3d
  choices:
  - text: Let me help you.
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 11400000, guid: 05d8158be52026845a29ffecf95b4b1c, type: 2}
    dialogueFact: {fileID: 11400000, guid: 154afc27c406ecd4fbed8b401efbf59b, type: 2}
    goldCost: 0
    requiredItem: {fileID: 0}
    signal: {fileID: 0}
  - text: You probably had it coming. Work harder.
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 11400000, guid: de502dc10f158dd4d9e7f8f36b6e0fd4, type: 2}
    dialogueFact: {fileID: 11400000, guid: 5f3af7d3cd827614fa3f0183980811d4, type: 2}
    goldCost: 0
    requiredItem: {fileID: 0}
    signal: {fileID: 0}
  - text: Then I'll leave you be.
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 11400000, guid: 30914580ee0961343bd6ae0cd3963821, type: 2}
