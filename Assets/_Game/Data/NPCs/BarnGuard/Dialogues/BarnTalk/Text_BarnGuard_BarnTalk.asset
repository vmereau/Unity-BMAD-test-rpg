  m_Script: {fileID: 11500000, guid: bc698db6e1221934e8011b9c737b57d7, type: 3}
  m_Name: Text_BarnGuard_BarnTalk
  m_EditorClassIdentifier: Game::Game.Dialogue.TextDialogueNode
  text: Pell's sacks again? Friend, I keep a gate, I don't count barley. But if you want my guess, it's one of the poor devils on the strips. Hungry men, a barn full of grain, and all night to think about it. Go and ask them, they'd know better than me.
  nextNode: {fileID: 11400000, guid: fb0c43eabdcad8043a194c87c06562da, type: 2}
