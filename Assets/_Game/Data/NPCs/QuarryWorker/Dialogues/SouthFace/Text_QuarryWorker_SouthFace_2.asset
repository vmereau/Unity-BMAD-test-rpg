  m_Script: {fileID: 11500000, guid: bc698db6e1221934e8011b9c737b57d7, type: 3}
  m_Name: Text_QuarryWorker_SouthFace_2
  m_EditorClassIdentifier: Game::Game.Dialogue.TextDialogueNode
  text: Last season the lads on the south face broke into a crack wide enough for a man, and the rock opens up behind it. So Dace starts a new cut in there. Not with the likes of us, mind you. He took his best cutters, men he trusts, and told the rest of us to stay at our own benches.
  nextNode: {fileID: 11400000, guid: 69290a930be86674e9a3f1f2de029097, type: 2}
