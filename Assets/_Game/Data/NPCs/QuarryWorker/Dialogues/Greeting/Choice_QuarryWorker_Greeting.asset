  m_Script: {fileID: 11500000, guid: a2bbd71de1c0dc944832b9f2ea09e57c, type: 3}
  m_Name: Choice_QuarryWorker_Greeting
  m_EditorClassIdentifier: Game::Game.Dialogue.ChoiceDialogueNode
  text: Long enough that the dust doesn't wash out any more. You're one of the new ones off the last cart, I'd guess. You've got that look, like you're still waiting for someone to tell you it was all a mistake.
  nextNode: {fileID: 0}
  _id: 105decf2f8201ef46bb3a6f4f1a471ea
  choices:
  - text: Any advice for a newcomer?
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 11400000, guid: ff22ddd322d891f48bef387e8cb18aaa, type: 2}
    dialogueFact: {fileID: 11400000, guid: 2697b2c2f1872d841bbfd9ef284da09f, type: 2}
    goldCost: 0
    requiredItem: {fileID: 0}
    requiredCategory: 0
    hideWhenMissing: 0
    signal: {fileID: 0}
  - text: Mind your own business, old man.
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 11400000, guid: 299d01fd0f9f8334f8d89af408607803, type: 2}
    dialogueFact: {fileID: 11400000, guid: d9c3e0f61db718745975490406275a9b, type: 2}
    goldCost: 0
    requiredItem: {fileID: 0}
    requiredCategory: 0
    hideWhenMissing: 0
    signal: {fileID: 0}
  - text: I have to go.
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 0}
    dialogueFact: {fileID: 0}
