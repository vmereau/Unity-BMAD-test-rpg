  m_EditorClassIdentifier: Game::Game.Dialogue.ChoiceDialogueNode
  text: You found him? Then tell me straight. I've had enough of people being kind to me with half the story.
  nextNode: {fileID: 0}
  _id: a01c94e1399f8ce4cacc300b4b91689f
  choices:
  - text: He's dead. He sat against the old stones, facing them, without a mark on him.
