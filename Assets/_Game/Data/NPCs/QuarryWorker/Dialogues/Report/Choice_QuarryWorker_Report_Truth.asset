    hideWhenMissing: 0
    signal: {fileID: 0}
  - text: Here. His ring.
    requiredMemory: {fileID: 0}
    nextNode: {fileID: 11400000, guid: cb2a3d013be0c3643924272095dd42e3, type: 2}
    dialogueFact: {fileID: 11400000, guid: caad1101ad6e37d4492d4ba4a5bd2913, type: 2}
